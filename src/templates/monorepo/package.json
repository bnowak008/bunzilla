{
  "name": "${projectName}",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently npm:dev:*",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun run --cwd packages/shared build",
    "build:apps": "bun run --cwd apps/client build && bun run --cwd apps/server build",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:push": "bun run --cwd apps/server db:push",
    "db:studio": "bun run --cwd apps/server db:studio",
    "setup": "bun install && bun run db:generate && bun run db:push"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@biomejs/biome": "1.4.1",
    "bun-types": "latest",
    "vitest": "^1.1.0",
    "concurrently": "^8.2.2"
  }
}