{
  "name": "${projectName}-api",
  "version": "1.0.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "db:push": "bun run drizzle-kit push:sqlite",
    "db:studio": "bun run drizzle-kit studio",
    "db:generate": "bun run drizzle-kit generate:sqlite"
  },
  "dependencies": {
    "elysia": "^0.8.0",
    "@elysiajs/cors": "^0.8.0",
    "@elysiajs/swagger": "^0.8.0",
    "drizzle-orm": "^0.29.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.20.0"
  }
} 